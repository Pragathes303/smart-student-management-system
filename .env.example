# ==============================================================================
# Environment Configuration Template for Smart Student Management System
# Copy this file to .env and customize values for your environment.
# DO NOT commit real secrets (.env) to version control!
# ==============================================================================

# Flask Core Configuration
FLASK_ENV=production
# DEBUG mode must be strictly OFF (0) by default in all environments
DEBUG=0
FLASK_DEBUG=0

# Secret key for session signing and CSRF protection (Minimum 32 characters required in production)
SECRET_KEY=replace-with-a-secure-random-key-at-least-32-chars-long
APP_BASE_URL=http://127.0.0.1:5000

# Database Configuration
# DATABASE_URL supports SQLite (sqlite:///database/students.db) and PostgreSQL (postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///database/students.db
DATABASE_PATH=database/students.db

# File Upload Folder (Stored outside template and source trees)
UPLOAD_FOLDER=frontend/static/uploads

# Storage Configuration ('local' or 's3')
# In 'local' mode, files are saved locally in UPLOAD_FOLDER
# In 's3' mode, files are uploaded to Amazon S3 using boto3
STORAGE_BACKEND=local

# AWS S3 Settings (Required only when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-student-system-bucket-name

# SMTP Mail Settings (Optional - for Password Reset delivery)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@institution.edu

# Application Logging Settings
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Administrator Initial Account Provisioning (Required in Production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-a-strong-password-with-8-chars-upper-lower-digit-special
ADMIN_EMAIL=admin@institution.edu

# Monitoring & Prometheus Scraping Token (Optional - Protects /metrics endpoint)
METRICS_TOKEN=replace-with-a-secure-metrics-bearer-token
